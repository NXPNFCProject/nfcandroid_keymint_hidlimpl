package {
    default_applicable_licenses: [
        "//hardware/nxp/keymint:hardware_nxp_keymint_license",
    ],
}

cc_binary {
    name: "android.hardware.security.keymint3-service.strongbox.nxp",
    defaults: [
        "jc_keymint_defaults.nxp",
        "libjc_keymint_defaults.nxp",
    ],
    init_rc: ["android.hardware.security.keymint3-service.strongbox.nxp.rc"],
    vintf_fragment_modules: [
        "android.hardware.security.keymint3-service.strongbox.nxp.xml",
        "android.hardware.security.sharedsecret-service.strongbox3.nxp.xml",
    ],
    shared_libs: [
        "android.hardware.security.keymint-V3-ndk",
        "lib_android_keymaster_keymint_utils_V3",
    ],
    srcs: [
        "KeyMint3Service.cpp",
    ],
    required: [
        "android.hardware.hardware_keystore.jc-strongbox-keymint3.nxp.xml",
    ],
    cflags: [
        "-DOMAPI_TRANSPORT",
        "-DNXP_EXTNS",
    ],
}

cc_binary {
    name: "android.hardware.security.keymint4-service.strongbox.nxp",
    init_rc: ["android.hardware.security.keymint4-service.strongbox.nxp.rc"],
    vintf_fragment_modules: [
        "android.hardware.security.keymint4-service.strongbox.nxp.xml",
        "android.hardware.security.sharedsecret-service.strongbox4.nxp.xml",
    ],
    defaults: [
        "jc_keymint_defaults.nxp",
        "libjc_keymint_defaults.nxp",
    ],
    shared_libs: [
        "android.hardware.security.keymint-V4-ndk",
        "lib_android_keymaster_keymint_utils_V4",
    ],
    srcs: [
        "JavacardKeyMint4Device.cpp",
        "KeyMint4Service.cpp",
    ],
    required: [
        "android.hardware.hardware_keystore.jc-strongbox-keymint4.nxp.xml",
    ],
    cflags: [
        "-DOMAPI_TRANSPORT",
        "-DNXP_EXTNS",
    ],
}

cc_defaults {
    name: "libjc_keymint_defaults.nxp",
    srcs: [
        "CborConverter.cpp",
        "JavacardKeyMintDevice.cpp",
        "JavacardKeyMintOperation.cpp",
        "JavacardRemotelyProvisionedComponentDevice.cpp",
        "JavacardSecureElement.cpp",
        "JavacardSharedSecret.cpp",
        "keymint_utils.cpp",
    ],
    cflags: [
        "-O0",
        "-DNXP_EXTNS",
        "-DINIT_USING_SEHAL_TRANSPORT",
    ],
    shared_libs: [
        "android.hardware.security.rkp-V3-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libkeymaster_portable",
        "libkeymaster_messages",
        "libsoft_attestation_cert",
        "liblog",
        "libcrypto",
        "libcutils",
        "libjc_keymint_transport.nxp",
        "android.hardware.secure_element-V1-ndk",
    ],
    export_shared_lib_headers: ["libjc_keymint_transport.nxp"],
    export_include_dirs: ["."],
    product_variables: {
        debuggable: {
            cflags: ["-DDCHECK_ALWAYS_ON"],
        },
    },
}

cc_defaults {
    name: "jc_keymint_defaults.nxp",
    relative_install_path: "hw",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    header_libs: ["keymint_common_headers"],
    shared_libs: [
        "android.se.omapi-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "libjc_keymint_transport.nxp",
        "libkeymaster_portable",
        "liblog",
        "libutils",
    ],
}

// The following targets (and underlying XML files) declare specific
// versions of KeyMint.  Vendors should use the version that matches the
// version of the KeyMint HAL that the device implements.

vintf_fragment {
    name: "android.hardware.security.keymint4-service.strongbox.nxp.xml",
    src: "android.hardware.security.keymint4-service.strongbox.nxp.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.security.sharedsecret-service.strongbox4.nxp.xml",
    src: "android.hardware.security.sharedsecret-service.strongbox4.nxp.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.security.keymint3-service.strongbox.nxp.xml",
    src: "android.hardware.security.keymint3-service.strongbox.nxp.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.security.sharedsecret-service.strongbox3.nxp.xml",
    src: "android.hardware.security.sharedsecret-service.strongbox3.nxp.xml",
    vendor: true,
}

prebuilt_etc {
    name: "android.hardware.hardware_keystore.jc-strongbox-keymint3.nxp.xml",
    sub_dir: "permissions",
    vendor: true,
    src: "android.hardware.hardware_keystore.jc-strongbox-keymint3.nxp.xml",
}

prebuilt_etc {
    name: "android.hardware.hardware_keystore.jc-strongbox-keymint4.nxp.xml",
    sub_dir: "permissions",
    vendor: true,
    src: "android.hardware.hardware_keystore.jc-strongbox-keymint4.nxp.xml",
}
